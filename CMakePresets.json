{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "SCIP_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "host-debug",
      "inherits": "base",
      "displayName": "PC - Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "host-asan",
      "inherits": "base",
      "displayName": "PC - Debug + Address/UB sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SCIP_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-release",
      "inherits": "base",
      "displayName": "PC - Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "imx8mp-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/imx8mp-myir-sdk.cmake"
    },
    {
      "name": "imx8mp-debug",
      "inherits": "imx8mp-base",
      "displayName": "i.MX 8M Plus - Debug (gdbserver)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "imx8mp-release",
      "inherits": "imx8mp-base",
      "displayName": "i.MX 8M Plus - Release (benchmarks)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "imx8mp-relwithdebinfo",
      "inherits": "imx8mp-base",
      "displayName": "i.MX 8M Plus - Release + debug symbols (perf)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "rk3588-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/rk3588-debian12.cmake"
    },
    {
      "name": "rk3588-debug",
      "inherits": "rk3588-base",
      "displayName": "RK3588 (ROCK 5B+) - Debug (gdbserver)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "rk3588-release",
      "inherits": "rk3588-base",
      "displayName": "RK3588 (ROCK 5B+) - Release (benchmarks)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "rk3588-relwithdebinfo",
      "inherits": "rk3588-base",
      "displayName": "RK3588 (ROCK 5B+) - Release + debug symbols (perf)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "host-debug", "configurePreset": "host-debug" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-release", "configurePreset": "host-release" },
    { "name": "imx8mp-debug", "configurePreset": "imx8mp-debug" },
    { "name": "imx8mp-release", "configurePreset": "imx8mp-release" },
    { "name": "imx8mp-relwithdebinfo", "configurePreset": "imx8mp-relwithdebinfo" },
    { "name": "rk3588-debug", "configurePreset": "rk3588-debug" },
    { "name": "rk3588-release", "configurePreset": "rk3588-release" },
    { "name": "rk3588-relwithdebinfo", "configurePreset": "rk3588-relwithdebinfo" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "host-debug", "inherits": "base", "configurePreset": "host-debug" },
    { "name": "host-asan", "inherits": "base", "configurePreset": "host-asan" },
    { "name": "host-release", "inherits": "base", "configurePreset": "host-release" },
    {
      "name": "imx8mp-release",
      "inherits": "base",
      "displayName": "i.MX 8M Plus - Release, run on the PC through QEMU",
      "configurePreset": "imx8mp-release"
    },
    {
      "name": "rk3588-release",
      "inherits": "base",
      "displayName": "RK3588 (ROCK 5B+) - Release, run on the PC through QEMU",
      "configurePreset": "rk3588-release"
    }
  ],
  "workflowPresets": [
    {
      "name": "host-check",
      "displayName": "Configure, build and test on the PC",
      "steps": [
        { "type": "configure", "name": "host-debug" },
        { "type": "build", "name": "host-debug" },
        { "type": "test", "name": "host-debug" }
      ]
    },
    {
      "name": "imx8mp-check",
      "displayName": "Cross-build for the board and test under QEMU",
      "steps": [
        { "type": "configure", "name": "imx8mp-release" },
        { "type": "build", "name": "imx8mp-release" },
        { "type": "test", "name": "imx8mp-release" }
      ]
    },
    {
      "name": "rk3588-check",
      "displayName": "Cross-build for the ROCK 5B+ and test under QEMU",
      "steps": [
        { "type": "configure", "name": "rk3588-release" },
        { "type": "build", "name": "rk3588-release" },
        { "type": "test", "name": "rk3588-release" }
      ]
    }
  ]
}
